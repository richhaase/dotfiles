# top-level EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

[*.{py,go}]
indent_style = space
indent_size = 4

[*.{json,js,ts,sh,bash,zsh,tf,hcl,lua}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 0

[Makefile]
indent_style = tab

[COMMIT_EDITMSG]
max_line_length = 0
