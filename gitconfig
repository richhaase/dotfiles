[user]
	name = "Rich Haase"
  email = "46830998+richhaase@users.noreply.github.com"
	username = "richhaase"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
  pager = delta
  excludesfile = ~/.gitignore_global

[delta]
  navigate = true
  side-by-side = true

[interactive]
  diffFilter = delta --color-only

[color]
	ui = auto
	branch = auto
	diff = auto
	status = auto

[fetch]
	prune = true
	recurseSubmodules = on-demand

[pull]
	rebase = merges

[status]
	submoduleSummary = true
	showUntrackedFiles = all
	short = false

[diff]
	submodule = log
	colorMoved = zebra

[log]
	abbrevCommit = true

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[rebase]
	autosquash = true

[merge]
	conflictstyle = diff3
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
