# .zshrc

ZPLUGINDIR="$HOME/.config/zsh/plugins"
export PATH="${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/opt/openssl/bin:$PATH"

source ~/.plugins.zsh

plugins=(
  sindresorhus/pure
  zsh-users/zsh-syntax-highlighting
  zsh-users/zsh-autosuggestions
)

plugin-load $plugins
autoload -U promptinit; promptinit
prompt pure

# Brewfile
export EDITOR=nvim
export HOMEBREW_BUNDLE_FILE="$HOME/.brewfile"

# kind
export KIND_EXPERIMENTAL_PROVIDER=podman

# neovim
which nvim &>/dev/null && alias vim=nvim && alias vi=nvim

# Aliases
alias lg="lazygit"
alias ll="erd -c ls"
alias du="erd -c du"
alias refresh=". ~/.zshrc"
alias be="vim ~/.brewfile && brew bundle --cleanup"
alias b="bat"
alias k="kubectl"
alias docker="podman"

# atuin
eval "$(atuin init zsh)"

# fzf
source <(fzf --zsh)

# asdf
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# wezterm
export PATH=$PATH:/Applications/WezTerm.app/Contents/MacOS

# Set AWS profile
function aws-profile() {
  if [ -z "$1" ]; then
    echo $AWS_PROFILE
  else
    export AWS_PROFILE=$1
  fi
}

# yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# zk
export ZK_NOTEBOOK_DIR="$HOME/notebook"

[[ -f $HOME/.zshrc.local ]] && . $HOME/.zshrc.local
