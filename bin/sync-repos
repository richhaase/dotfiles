#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${SYNC_REPOS_CONFIG:-$HOME/.config/sync-repos/config.json}"

MODE="sync"
DIR_ARG=""
OWNER=""
TARGET_FLAG=""
DAYS=""
EVENTS=""
DRY_RUN=false
CLEANUP=false
FORCE=false
EXCLUDES_FILE=""
EXCLUDES=()

usage() {
  cat <<EOF
Usage: sync-repos [DIR] [OPTIONS]
       sync-repos all [OPTIONS]
       sync-repos add DIR [OPTIONS]
       sync-repos list
       sync-repos remove DIR

Clone and fast-forward recently active GitHub repos for a user or org.
Dirty worktrees, non-default branches, and diverged histories are reported
but never touched, unless -f/--force is given.

With DIR, settings for that directory are loaded from the config file and any
flags act as overrides. Register a directory with 'sync-repos add'. Without
DIR, flags and built-in defaults apply.

'all' syncs every configured target in config order, applying any flags to
each. 'add' registers or replaces a sync target, 'list' shows all configured
targets, and 'remove' deletes one. The config is plain JSON and safe to edit
by hand: $CONFIG_FILE
(override the path with SYNC_REPOS_CONFIG)

Options:
  -o, --owner OWNER        GitHub user or org (default: authenticated gh user)
  -t, --target DIR         Parent directory for clones (default: ~/src)
  -d, --days N             Activity window in days (default: 45)
  -e, --exclude PATTERN    Skip repos matching glob PATTERN (repeatable)
      --excludes-file FILE Read exclude patterns from FILE, one per line
                           (blank lines and #-comments ignored)
      --events             Use the events-API activity fallback
      --no-events          Judge activity by pushes only
  -f, --force              Discard local changes and check out the default
                           branch, hard-resetting it to origin (destructive)
  -c, --cleanup            Remove clean clones of repos inactive beyond the window
  -n, --dry-run            Show what would happen without changing anything
  -h, --help               Show this help

Examples:
  sync-repos add ~/src
  sync-repos add ~/dev --owner teamsense --no-events -e 'prototype-*'
  sync-repos ~/dev
  sync-repos ~/src -n
  sync-repos list
  sync-repos remove ~/dev
  sync-repos all -n
EOF
}

if [[ $# -gt 0 ]]; then
  case "$1" in
    add|list|remove|all) MODE="$1"; shift ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--owner) OWNER="$2"; shift 2 ;;
    -t|--target) TARGET_FLAG="$2"; shift 2 ;;
    -d|--days) DAYS="$2"; shift 2 ;;
    -e|--exclude) EXCLUDES+=("$2"); shift 2 ;;
    --excludes-file) EXCLUDES_FILE="$2"; shift 2 ;;
    --events) EVENTS=true; shift ;;
    --no-events) EVENTS=false; shift ;;
    -f|--force) FORCE=true; shift ;;
    -c|--cleanup) CLEANUP=true; shift ;;
    -n|--dry-run) DRY_RUN=true; shift ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "sync-repos: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$DIR_ARG" ]]; then
        echo "sync-repos: unexpected extra argument: $1" >&2
        exit 2
      fi
      DIR_ARG="$1"
      shift
      ;;
  esac
done

for cmd in gh jq git; do
  command -v "$cmd" >/dev/null || { echo "sync-repos: missing dependency: $cmd" >&2; exit 1; }
done

normalize_dir() {
  local d="$1"
  d="${d%/}"
  case "$d" in
    "~") d="$HOME" ;;
    "~/"*) d="$HOME/${d#\~/}" ;;
  esac
  [[ "$d" == /* ]] || d="$PWD/$d"
  printf '%s\n' "$d"
}

load_excludes_file() {
  local file="$1" line
  if [[ ! -f "$file" ]]; then
    echo "sync-repos: excludes file not found: $file" >&2
    exit 2
  fi
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    EXCLUDES+=("$line")
  done < "$file"
}

if [[ -n "$EXCLUDES_FILE" ]]; then
  load_excludes_file "$EXCLUDES_FILE"
fi

if [[ "$MODE" == "add" ]]; then
  if [[ -z "$DIR_ARG" ]]; then
    echo "sync-repos: add requires a directory" >&2
    exit 2
  fi
  if $CLEANUP || $DRY_RUN || $FORCE || [[ -n "$TARGET_FLAG" ]]; then
    echo "sync-repos: add only accepts --owner, --days, --events/--no-events, -e, --excludes-file" >&2
    exit 2
  fi
  TARGET_DIR=$(normalize_dir "$DIR_ARG")
  [[ -n "$OWNER" ]] || OWNER=$(gh api user --jq .login)
  [[ -n "$DAYS" ]] || DAYS=45
  [[ -n "$EVENTS" ]] || EVENTS=true
  if ! [[ "$DAYS" =~ ^[0-9]+$ ]] || (( DAYS < 1 )); then
    echo "sync-repos: --days must be a positive integer" >&2
    exit 2
  fi

  mkdir -p "$(dirname "$CONFIG_FILE")"
  [[ -f "$CONFIG_FILE" ]] || echo '{"targets": []}' > "$CONFIG_FILE"

  ENTRY=$(jq -n \
    --arg dir "$TARGET_DIR" \
    --arg owner "$OWNER" \
    --argjson days "$DAYS" \
    --argjson events "$EVENTS" \
    '{dir: $dir, owner: $owner, days: $days, events: $events, excludes: $ARGS.positional}' \
    --args ${EXCLUDES[@]+"${EXCLUDES[@]}"})

  TMP=$(mktemp "${TMPDIR:-/tmp}/sync-repos.XXXXXX")
  jq --argjson entry "$ENTRY" \
    '.targets = ([(.targets // [])[] | select(.dir != $entry.dir)] + [$entry])' \
    "$CONFIG_FILE" > "$TMP"
  mv "$TMP" "$CONFIG_FILE"

  echo "registered target in $CONFIG_FILE:"
  jq --argjson entry "$ENTRY" -n '$entry'
  exit 0
fi

if [[ "$MODE" == "list" ]]; then
  if [[ -n "$DIR_ARG" ]]; then
    echo "sync-repos: list takes no arguments" >&2
    exit 2
  fi
  if [[ ! -f "$CONFIG_FILE" ]] || [[ $(jq '(.targets // []) | length' "$CONFIG_FILE") -eq 0 ]]; then
    echo "no configured targets in $CONFIG_FILE"
    exit 0
  fi
  jq -r '(.targets // [])[] |
    "\(.dir)\n  owner: \(.owner)   days: \(.days)   events: \(.events)   excludes: \(if (.excludes | length) == 0 then "(none)" else (.excludes | join(", ")) end)"' \
    "$CONFIG_FILE"
  exit 0
fi

if [[ "$MODE" == "remove" ]]; then
  if [[ -z "$DIR_ARG" ]]; then
    echo "sync-repos: remove requires a directory" >&2
    exit 2
  fi
  TARGET_DIR=$(normalize_dir "$DIR_ARG")
  ENTRY=""
  if [[ -f "$CONFIG_FILE" ]]; then
    ENTRY=$(jq -c --arg dir "$TARGET_DIR" \
      'first((.targets // [])[] | select(.dir == $dir)) // empty' "$CONFIG_FILE")
  fi
  if [[ -z "$ENTRY" ]]; then
    echo "sync-repos: no configured target for $TARGET_DIR" >&2
    exit 2
  fi
  TMP=$(mktemp "${TMPDIR:-/tmp}/sync-repos.XXXXXX")
  jq --arg dir "$TARGET_DIR" \
    '.targets = [(.targets // [])[] | select(.dir != $dir)]' \
    "$CONFIG_FILE" > "$TMP"
  mv "$TMP" "$CONFIG_FILE"
  echo "removed target $TARGET_DIR from $CONFIG_FILE"
  exit 0
fi

if [[ "$MODE" == "all" ]]; then
  if [[ -n "$DIR_ARG" || -n "$TARGET_FLAG" ]]; then
    echo "sync-repos: all takes no directory" >&2
    exit 2
  fi
  if [[ ! -f "$CONFIG_FILE" ]] || [[ $(jq '(.targets // []) | length' "$CONFIG_FILE") -eq 0 ]]; then
    echo "sync-repos: no configured targets in $CONFIG_FILE" >&2
    exit 2
  fi
  PASS=()
  [[ -n "$OWNER" ]] && PASS+=(-o "$OWNER")
  [[ -n "$DAYS" ]] && PASS+=(-d "$DAYS")
  [[ "$EVENTS" == "true" ]] && PASS+=(--events)
  [[ "$EVENTS" == "false" ]] && PASS+=(--no-events)
  $FORCE && PASS+=(-f)
  $CLEANUP && PASS+=(-c)
  $DRY_RUN && PASS+=(-n)
  for pat in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do
    PASS+=(-e "$pat")
  done
  overall=0
  while IFS= read -r dir; do
    echo "=== $dir ==="
    "$0" "$dir" ${PASS[@]+"${PASS[@]}"} || overall=1
    echo ""
  done < <(jq -r '(.targets // [])[].dir' "$CONFIG_FILE")
  exit $overall
fi

if [[ -n "$DIR_ARG" && -n "$TARGET_FLAG" ]]; then
  echo "sync-repos: pass a directory or -t/--target, not both" >&2
  exit 2
fi

if [[ -n "$DIR_ARG" ]]; then
  TARGET_DIR=$(normalize_dir "$DIR_ARG")
  ENTRY=""
  if [[ -f "$CONFIG_FILE" ]]; then
    ENTRY=$(jq -c --arg dir "$TARGET_DIR" \
      'first((.targets // [])[] | select(.dir == $dir)) // empty' "$CONFIG_FILE")
  fi
  if [[ -z "$ENTRY" ]]; then
    echo "sync-repos: no configured target for $TARGET_DIR" >&2
    echo "register it with: sync-repos add $TARGET_DIR [OPTIONS]" >&2
    echo "or sync ad hoc with: sync-repos -t $TARGET_DIR [OPTIONS]" >&2
    exit 2
  fi
  [[ -n "$OWNER" ]] || OWNER=$(jq -r .owner <<<"$ENTRY")
  [[ -n "$DAYS" ]] || DAYS=$(jq -r .days <<<"$ENTRY")
  [[ -n "$EVENTS" ]] || EVENTS=$(jq -r .events <<<"$ENTRY")
  while IFS= read -r pat; do
    EXCLUDES+=("$pat")
  done < <(jq -r '.excludes[]?' <<<"$ENTRY")
else
  TARGET_DIR="${TARGET_FLAG:-$HOME/src}"
  TARGET_DIR=$(normalize_dir "$TARGET_DIR")
  [[ -n "$OWNER" ]] || OWNER=$(gh api user --jq .login)
  [[ -n "$DAYS" ]] || DAYS=45
  [[ -n "$EVENTS" ]] || EVENTS=true
fi

if ! [[ "$DAYS" =~ ^[0-9]+$ ]] || (( DAYS < 1 )); then
  echo "sync-repos: --days must be a positive integer" >&2
  exit 2
fi

is_excluded() {
  local name="$1" pat
  for pat in ${EXCLUDES[@]+"${EXCLUDES[@]}"}; do
    [[ "$name" == $pat ]] && return 0
  done
  return 1
}

is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]]
}

CUTOFF=$(date -u -v-"${DAYS}"d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
  || date -u -d "${DAYS} days ago" +%Y-%m-%dT%H:%M:%SZ)

mkdir -p "$TARGET_DIR"

EXCL_DESC="${EXCLUDES[*]-}"
echo "owner:    $OWNER"
echo "target:   $TARGET_DIR"
echo "window:   ${DAYS}d (since $CUTOFF)"
echo "excludes: ${EXCL_DESC:-(none)}"
echo "events:   $EVENTS"
echo "force:    $FORCE"
echo "cleanup:  $CLEANUP"
echo "dry run:  $DRY_RUN"
echo ""

REPOS=$(gh repo list "$OWNER" --no-archived --limit 500 \
  --json name,nameWithOwner,pushedAt,defaultBranchRef)

cloned=()
updated=()
skipped=()
errors=()
inactive=()
removed=()
forced=()
uptodate=0
excluded=0

while IFS= read -r repo; do
  NAME=$(jq -r .name <<<"$repo")
  FULL=$(jq -r .nameWithOwner <<<"$repo")
  PUSHED=$(jq -r .pushedAt <<<"$repo")
  BRANCH=$(jq -r '.defaultBranchRef.name // ""' <<<"$repo")

  if is_excluded "$NAME"; then
    excluded=$((excluded + 1))
    continue
  fi

  active=false
  if [[ "$PUSHED" > "$CUTOFF" ]]; then
    active=true
  elif [[ "$EVENTS" == "true" ]]; then
    LAST_EVENT=$(gh api "repos/$FULL/events" --jq '.[0].created_at // empty' 2>/dev/null || true)
    [[ -n "$LAST_EVENT" && "$LAST_EVENT" > "$CUTOFF" ]] && active=true
  fi
  if ! $active; then
    inactive+=("$NAME")
    continue
  fi

  DEST="$TARGET_DIR/$NAME"

  if [[ ! -e "$DEST" ]]; then
    if $DRY_RUN; then
      echo "  + $NAME (would clone)"
      cloned+=("$NAME")
    elif gh repo clone "$FULL" "$DEST" -- --quiet; then
      echo "  + $NAME (cloned)"
      cloned+=("$NAME")
    else
      echo "  x $NAME (clone failed)"
      errors+=("$NAME clone failed")
    fi
    continue
  fi

  if [[ ! -d "$DEST/.git" ]]; then
    echo "  ! $NAME (exists but not a git repo)"
    skipped+=("$NAME exists but not a git repo")
    continue
  fi

  if $DRY_RUN; then
    CURRENT=$(git -C "$DEST" branch --show-current 2>/dev/null || true)
    if $FORCE; then
      if [[ -z "$BRANCH" ]]; then
        echo "  ~ $NAME (no default branch — would fetch only)"
        skipped+=("$NAME no default branch")
        continue
      fi
      reasons=()
      is_dirty "$DEST" && reasons+=("dirty")
      [[ "$CURRENT" != "$BRANCH" ]] && reasons+=("on ${CURRENT:-detached}")
      if (( ${#reasons[@]} )); then
        DETAIL=$(printf '%s, ' "${reasons[@]}"); DETAIL=${DETAIL%, }
        echo "  ↓ $NAME (would force $BRANCH to origin/$BRANCH — $DETAIL)"
        forced+=("$NAME ($DETAIL)")
      else
        echo "  ↓ $NAME (would fetch and update $BRANCH)"
        updated+=("$NAME")
      fi
      continue
    fi
    if is_dirty "$DEST"; then
      echo "  ~ $NAME (dirty working tree — would fetch only)"
      skipped+=("$NAME dirty")
    elif [[ -z "$BRANCH" ]]; then
      echo "  ~ $NAME (no default branch — would fetch only)"
      skipped+=("$NAME no default branch")
    elif [[ "$CURRENT" != "$BRANCH" ]]; then
      echo "  ~ $NAME (on ${CURRENT:-detached}, not $BRANCH — would fetch only)"
      skipped+=("$NAME on ${CURRENT:-detached}")
    else
      echo "  ↓ $NAME (would fetch and update $BRANCH)"
      updated+=("$NAME")
    fi
    continue
  fi

  if ! git -C "$DEST" fetch --all --prune --quiet 2>/dev/null; then
    echo "  x $NAME (fetch failed)"
    errors+=("$NAME fetch failed")
    continue
  fi

  if $FORCE; then
    if [[ -z "$BRANCH" ]]; then
      echo "  ~ $NAME (no default branch — fetched only)"
      skipped+=("$NAME no default branch")
      continue
    fi
    REMOTE="origin/$BRANCH"
    if ! git -C "$DEST" rev-parse --verify --quiet "$REMOTE" >/dev/null; then
      echo "  ~ $NAME (no $REMOTE — fetched only)"
      skipped+=("$NAME no $REMOTE")
      continue
    fi
    CURRENT=$(git -C "$DEST" branch --show-current 2>/dev/null || true)
    reasons=()
    is_dirty "$DEST" && reasons+=("was dirty")
    [[ "$CURRENT" != "$BRANCH" ]] && reasons+=("was on ${CURRENT:-detached}")
    if (( ${#reasons[@]} == 0 )); then
      if [[ "$(git -C "$DEST" rev-parse HEAD)" == "$(git -C "$DEST" rev-parse "$REMOTE")" ]]; then
        echo "  ✓ $NAME (up to date)"
        uptodate=$((uptodate + 1))
        continue
      fi
      if ! git -C "$DEST" merge-base --is-ancestor HEAD "$REMOTE" 2>/dev/null; then
        reasons+=("was diverged")
      fi
    fi
    if git -C "$DEST" checkout -q -f -B "$BRANCH" "$REMOTE" 2>/dev/null; then
      if (( ${#reasons[@]} )); then
        DETAIL=$(printf '%s, ' "${reasons[@]}"); DETAIL=${DETAIL%, }
        echo "  ↓ $NAME (forced $BRANCH to $REMOTE — $DETAIL)"
        forced+=("$NAME ($DETAIL)")
      else
        echo "  ↓ $NAME (fast-forwarded $BRANCH)"
        updated+=("$NAME")
      fi
    else
      echo "  x $NAME (force checkout failed)"
      errors+=("$NAME force checkout failed")
    fi
    continue
  fi

  if is_dirty "$DEST"; then
    echo "  ~ $NAME (dirty working tree — fetched only)"
    skipped+=("$NAME dirty")
    continue
  fi

  CURRENT=$(git -C "$DEST" branch --show-current 2>/dev/null || true)
  if [[ -z "$BRANCH" ]]; then
    echo "  ~ $NAME (no default branch — fetched only)"
    skipped+=("$NAME no default branch")
    continue
  fi
  if [[ "$CURRENT" != "$BRANCH" ]]; then
    echo "  ~ $NAME (on ${CURRENT:-detached}, not $BRANCH — fetched only)"
    skipped+=("$NAME on ${CURRENT:-detached}")
    continue
  fi

  REMOTE="origin/$BRANCH"
  if ! git -C "$DEST" rev-parse --verify --quiet "$REMOTE" >/dev/null; then
    echo "  ~ $NAME (no $REMOTE — fetched only)"
    skipped+=("$NAME no $REMOTE")
  elif [[ "$(git -C "$DEST" rev-parse HEAD)" == "$(git -C "$DEST" rev-parse "$REMOTE")" ]]; then
    echo "  ✓ $NAME (up to date)"
    uptodate=$((uptodate + 1))
  elif git -C "$DEST" merge-base --is-ancestor HEAD "$REMOTE" 2>/dev/null; then
    if git -C "$DEST" merge --ff-only --quiet "$REMOTE" 2>/dev/null; then
      echo "  ↓ $NAME (fast-forwarded $BRANCH)"
      updated+=("$NAME")
    else
      echo "  x $NAME (fast-forward failed)"
      errors+=("$NAME fast-forward failed")
    fi
  else
    echo "  ~ $NAME (diverged from $REMOTE — fetched only)"
    skipped+=("$NAME diverged")
  fi
done < <(jq -c '.[]' <<<"$REPOS")

if $CLEANUP; then
  echo ""
  echo "cleanup (inactive beyond ${DAYS}d):"
  if (( ${#inactive[@]} )); then
    for NAME in "${inactive[@]}"; do
      DEST="$TARGET_DIR/$NAME"
      [[ -d "$DEST/.git" ]] || continue
      if is_dirty "$DEST"; then
        echo "  ! $NAME (inactive but has uncommitted or untracked changes — keeping)"
        skipped+=("$NAME inactive but dirty")
        continue
      fi
      if $DRY_RUN; then
        echo "  - $NAME (would remove)"
      else
        echo "  - $NAME (removed)"
        rm -rf "$DEST"
      fi
      removed+=("$NAME")
    done
  fi
  if (( ${#removed[@]} == 0 )); then
    echo "  (nothing to remove)"
  fi
fi

echo ""
echo "=== summary ==="
echo "cloned:          ${#cloned[@]}"
if (( ${#cloned[@]} )); then for r in "${cloned[@]}"; do echo "  + $r"; done; fi
echo "fast-forwarded:  ${#updated[@]}"
if (( ${#updated[@]} )); then for r in "${updated[@]}"; do echo "  ↓ $r"; done; fi
if $FORCE; then
  echo "forced:          ${#forced[@]}"
  if (( ${#forced[@]} )); then for r in "${forced[@]}"; do echo "  ↓ $r"; done; fi
fi
echo "up to date:      $uptodate"
echo "skipped:         ${#skipped[@]}"
if (( ${#skipped[@]} )); then for r in "${skipped[@]}"; do echo "  ~ $r"; done; fi
echo "inactive:        ${#inactive[@]}"
echo "excluded:        $excluded"
if $CLEANUP; then
  echo "removed:         ${#removed[@]}"
  if (( ${#removed[@]} )); then for r in "${removed[@]}"; do echo "  - $r"; done; fi
fi
if (( ${#errors[@]} )); then
  echo "errors:          ${#errors[@]}"
  for r in "${errors[@]}"; do echo "  x $r"; done
  exit 1
fi
